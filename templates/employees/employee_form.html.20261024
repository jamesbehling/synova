{% extends 'base.html' %}

{% block content %}
        <div class="mb-6">
            <h2 class="text-2xl font-bold text-slate-900 mb-1">
                {% if form.instance.pk %}Edit Employee{% else %}Add New Employee{% endif %}
            </h2>
            <p class="text-gray-600 text-sm">Update employee information and employment details</p>
        </div>

        <!-- Form Container -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <form method="post">
                {% csrf_token %}

                <!-- Form Fields -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    
                    <!-- Prefix -->
                    {% if form.prefix %}
                    <div class="form-group">
                        <label class="form-label" for="{{ form.prefix.id_for_label }}">Prefix</label>
                        {{ form.prefix }}
                    </div>
                    {% endif %}

                    <!-- First Name -->
                    {% if form.first_name %}
                    <div class="form-group">
                        <label class="form-label" for="{{ form.first_name.id_for_label }}">First Name *</label>
                        {{ form.first_name }}
                    </div>
                    {% endif %}

                    <!-- Middle Name -->
                    {% if form.middle_name %}
                    <div class="form-group">
                        <label class="form-label" for="{{ form.middle_name.id_for_label }}">Middle Name</label>
                        {{ form.middle_name }}
                    </div>
                    {% endif %}

                    <!-- Last Name -->
                    {% if form.last_name %}
                    <div class="form-group">
                        <label class="form-label" for="{{ form.last_name.id_for_label }}">Last Name *</label>
                        {{ form.last_name }}
                    </div>
                    {% endif %}

                    <!-- Suffix -->
                    {% if form.suffix %}
                    <div class="form-group">
                        <label class="form-label" for="{{ form.suffix.id_for_label }}">Suffix</label>
                        {{ form.suffix }}
                    </div>
                    {% endif %}

                    <!-- Title -->
                    {% if form.title %}
                    <div class="form-group md:col-span-1">
                        <label class="form-label" for="{{ form.title.id_for_label }}">Title *</label>
                        {{ form.title }}
                    </div>
                    {% endif %}

                    <!-- Manager -->
                    {% if form.manager %}
                    <div class="form-group md:col-span-2">
                        <label class="form-label" for="{{ form.manager.id_for_label }}">Manager</label>
                        {{ form.manager }}
                    </div>
                    {% endif %}

                    <!-- Email -->
                    {% if form.email %}
                    <div class="form-group md:col-span-1">
                        <label class="form-label" for="{{ form.email.id_for_label }}">Email</label>
                        {{ form.email }}
                    </div>
                    {% endif %}

                    <!-- Phone -->
                    {% if form.phone %}
                    <div class="form-group md:col-span-1">
                        <label class="form-label" for="{{ form.phone.id_for_label }}">Phone</label>
                        {{ form.phone }}
                    </div>
                    {% endif %}

                    <!-- Hire Date -->
                    {% if form.hire_date %}
                    <div class="form-group md:col-span-1">
                        <label class="form-label" for="{{ form.hire_date.id_for_label }}">Hire Date</label>
                        {{ form.hire_date }}
                    </div>
                    {% endif %}

                    <!-- Terminated Date -->
                    {% if form.terminated_date %}
                    <div class="form-group md:col-span-1">
                        <label class="form-label" for="{{ form.terminated_date.id_for_label }}">Terminated Date</label>
                        {{ form.terminated_date }}
                    </div>
                    {% endif %}

                    <!-- Active Status -->
                    {% if form.active %}
                    <div class="form-group md:col-span-2">
                        <div class="flex items-center">
                            {{ form.active }}
                            <label class="form-label ml-2 mb-0" for="{{ form.active.id_for_label }}">Active</label>
                        </div>
                    </div>
                    {% endif %}

                </div>

                <!-- Form Errors -->
                {% if form.non_field_errors %}
                <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
                    {% for error in form.non_field_errors %}
                        <p>{{ error }}</p>
                    {% endfor %}
                </div>
                {% endif %}

                <!-- Action Buttons -->
                <div class="mt-6 flex gap-3">
                    <button type="submit" class="bg-synova-teal hover-synova-teal text-white px-6 py-2 rounded-lg font-semibold text-sm transition">
                        Save Employee
                    </button>
                    <a href="{% url 'employee_list' %}" class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-6 py-2 rounded-lg font-semibold text-sm transition">
                        Cancel
                    </a>
                </div>
            </form>
        </div>

{% endblock %}
